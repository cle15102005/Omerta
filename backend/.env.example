# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://omerta:omerta_dev_secret@localhost:27017/omerta?authSource=admin

# ── Secrets (CHANGE THESE IN PRODUCTION — min 32 chars for JWT_SECRET) ────────
JWT_SECRET=change-this-in-production-min-32-chars

# ── JWT / Session ─────────────────────────────────────────────────────────────
# Format: Nh (hours) | Nd (days) | Nm (minutes). Cookie maxAge auto-synced.
JWT_EXPIRY=24h

# ── Bcrypt ────────────────────────────────────────────────────────────────────
# Hash cost rounds. 10 = fast (dev/low-end hardware), 12 = standard, 14 = strict.
# NOTE: changing this does NOT affect existing password hashes, only new registrations.
BCRYPT_ROUNDS=12

# ── Account Lockout ───────────────────────────────────────────────────────────
# How many consecutive failed logins before locking the account.
LOCKOUT_MAX_ATTEMPTS=5
# How many minutes the account stays locked.
LOCKOUT_DURATION_MIN=15

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Login / recover endpoints: max attempts per IP per window.
RATE_AUTH_MAX=5
RATE_AUTH_WINDOW_MIN=15
# Salt lookup endpoints: max requests per IP per minute.
RATE_SALT_MAX=20
# Register endpoint: max new accounts per IP per hour.
RATE_REGISTER_MAX=3

# ── Request Body ──────────────────────────────────────────────────────────────
# Maximum allowed JSON body size. Prevents payload-based DoS.
BODY_LIMIT=100kb

# ── Vault ─────────────────────────────────────────────────────────────────────
# How many previous versions to keep per vault item (git-like history).
VAULT_HISTORY_LIMIT=10
